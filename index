<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Koło Fortuny</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #0c0824;
    --navy-2: #150f38;
    --navy-3: #1c1444;
    --gold: #f2b705;
    --gold-2: #ffdd57;
    --wine: #b3123f;
    --paper: #fff6df;
    --ok: #3fbf6a;
    --bad: #e0473f;
    --ring-shadow: 0 0 60px rgba(242,183,5,0.35);
  }

  *{ box-sizing:border-box; }

  html,body{
    margin:0;
    padding:0;
    min-height:100vh;
    background:
      radial-gradient(circle at 50% 18%, rgba(255,221,87,0.10), transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(179,18,63,0.25), transparent 60%),
      var(--navy);
    font-family:'Poppins', sans-serif;
    color:var(--paper);
    overflow-x:hidden;
  }

  .stage{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
    padding:36px 16px 60px;
    position:relative;
  }

  /* ---------- Top-left add button ---------- */
  .add-btn{
    position:fixed;
    top:20px;
    left:20px;
    z-index:50;
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:0.82rem;
    letter-spacing:0.04em;
    padding:11px 18px;
    border-radius:10px;
    border:2px solid var(--gold);
    background:linear-gradient(180deg, var(--navy-3), var(--navy));
    color:var(--gold-2);
    cursor:pointer;
    box-shadow:0 6px 14px rgba(0,0,0,0.4);
    display:flex;
    align-items:center;
    gap:8px;
    transition:transform 0.1s ease, filter 0.15s ease;
  }
  .add-btn:hover{ filter:brightness(1.15); }
  .add-btn:active{ transform:translateY(2px); }
  .add-btn svg{ width:16px; height:16px; }

  .pkt-btn{
    position:fixed;
    top:20px;
    right:20px;
    left:auto;
  }

  /* ---------- Marquee title ---------- */
  .marquee{
    position:relative;
    padding:14px 46px;
    border-radius:14px;
    background:linear-gradient(180deg, #1c1444, #0c0824);
    border:3px solid var(--gold);
    box-shadow: 0 0 0 6px #2a1c5c, var(--ring-shadow);
    margin-bottom:8px;
  }
  .marquee h1{
    font-family:'Bebas Neue', sans-serif;
    font-size:clamp(1.5rem, 3vw, 2.4rem);
    letter-spacing:0.12em;
    margin:0;
    text-align:center;
    background:linear-gradient(180deg, #fff7d6 0%, var(--gold) 55%, #b9860a 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    text-shadow: 0 2px 0 rgba(0,0,0,0.25);
  }
  .bulbs{ position:absolute; inset:0; border-radius:14px; pointer-events:none; }
  .bulb{
    position:absolute; width:8px; height:8px; border-radius:50%;
    background:var(--gold-2);
    box-shadow:0 0 8px 2px rgba(255,221,87,0.9);
    animation:twinkle 1.4s infinite ease-in-out;
  }
  @keyframes twinkle{ 0%,100%{ opacity:0.25; } 50%{ opacity:1; } }

  .subtitle{
    font-size:0.78rem;
    letter-spacing:0.35em;
    text-transform:uppercase;
    color:#c9bff0;
    margin:6px 0 30px;
  }

  /* ---------- Two-column game layout ---------- */
  .game-layout{
    width:100%;
    max-width:1180px;
    display:grid;
    grid-template-columns:1.15fr 1fr;
    gap:40px;
    align-items:start;
  }
  @media (max-width:880px){
    .game-layout{ grid-template-columns:1fr; }
  }

  /* ---------- Puzzle panel (left) ---------- */
  .puzzle-panel{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:26px;
    padding-top:8px;
  }

  .board{
    width:100%;
    background:linear-gradient(180deg, #142a5e, #0c1a3f);
    border:4px solid var(--gold);
    border-radius:16px;
    padding:24px 18px;
    box-shadow:0 16px 30px rgba(0,0,0,0.45), inset 0 0 20px rgba(0,0,0,0.35);
    min-height:150px;
    display:flex;
    flex-wrap:wrap;
    align-content:center;
    justify-content:center;
    gap:10px 0;
    position:relative;
  }
  .board.solved{
    border-color:var(--ok);
    box-shadow:0 0 0 4px rgba(63,191,106,0.25), 0 16px 30px rgba(0,0,0,0.45);
  }
  .solved-banner{
    position:absolute;
    top:-14px;
    left:50%;
    transform:translateX(-50%);
    background:var(--ok);
    color:#08240f;
    font-family:'Bebas Neue', sans-serif;
    letter-spacing:0.1em;
    font-size:0.9rem;
    padding:4px 16px;
    border-radius:999px;
    box-shadow:0 4px 10px rgba(0,0,0,0.4);
    opacity:0;
    transition:opacity 0.3s ease;
  }
  .solved-banner.show{ opacity:1; }

  .word-group{
    display:flex;
    gap:5px;
    margin:0 28px 6px 0;
  }

  .letter-box{
    width:clamp(30px, 5.5vw, 48px);
    height:clamp(38px, 7vw, 58px);
    background:var(--paper);
    border-radius:4px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Bebas Neue', sans-serif;
    font-size:clamp(1.4rem, 3.6vw, 2.1rem);
    color:var(--navy);
    box-shadow:0 3px 0 rgba(0,0,0,0.35), inset 0 -2px 0 rgba(0,0,0,0.08);
  }
  .letter-box.blank{
    background:rgba(255,246,223,0.12);
    color:transparent;
    box-shadow:inset 0 0 0 2px rgba(255,246,223,0.35);
  }
  .letter-box.reveal-anim{
    animation:pop 0.28s ease;
  }
  @keyframes pop{
    0%{ transform:scale(0.4); }
    70%{ transform:scale(1.12); }
    100%{ transform:scale(1); }
  }
  .letter-box.static{
    background:transparent;
    box-shadow:none;
    color:var(--gold-2);
    width:clamp(10px, 2vw, 16px);
  }

  .redraw-btn{
    font-family:'Poppins', sans-serif;
    font-size:0.75rem;
    font-weight:700;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:#c9bff0;
    background:transparent;
    border:1px solid #3a3167;
    padding:8px 16px;
    border-radius:8px;
    cursor:pointer;
    transition:all 0.15s ease;
  }
  .redraw-btn:hover{ color:var(--gold-2); border-color:var(--gold); }

  .puzzle-controls{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:center;
    gap:10px 14px;
  }
  .select-phrase{
    display:flex;
    align-items:center;
    gap:8px;
  }
  .select-phrase select{
    font-family:'Poppins', sans-serif;
    font-size:0.78rem;
    font-weight:600;
    color:var(--paper);
    background:var(--navy-3);
    border:1px solid #3a3167;
    border-radius:8px;
    padding:8px 10px;
    max-width:220px;
    cursor:pointer;
    outline:none;
  }
  .select-phrase select:focus{ border-color:var(--gold); }

  /* ---------- Keyboard ---------- */
  .keyboard{
    display:flex;
    flex-direction:row;
    align-items:flex-start;
    justify-content:center;
    gap:28px;
    width:100%;
    flex-wrap:wrap;
  }
  .kb-group{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
  }
  .kb-group-label{
    font-size:0.7rem;
    font-weight:700;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:#c9bff0;
    margin-bottom:2px;
  }
  .kb-row{
    display:flex;
    gap:6px;
    justify-content:center;
    flex-wrap:wrap;
  }
  .key{
    min-width:34px;
    height:40px;
    padding:0 6px;
    border-radius:8px;
    border:2px solid var(--gold);
    background:linear-gradient(180deg, var(--navy-3), var(--navy));
    color:var(--paper);
    font-family:'Bebas Neue', sans-serif;
    font-size:1.05rem;
    letter-spacing:0.02em;
    cursor:pointer;
    box-shadow:0 4px 0 #6b4d05, 0 6px 10px rgba(0,0,0,0.3);
    transition:transform 0.08s ease, filter 0.1s ease;
  }
  .key:hover:not(:disabled){ filter:brightness(1.15); }
  .key:active:not(:disabled){ transform:translateY(3px); box-shadow:0 1px 0 #6b4d05; }
  .key:disabled{
    cursor:not-allowed;
    opacity:0.35;
    box-shadow:none;
    transform:none;
  }
  .key.key-correct{
    border-color:var(--ok);
    background:linear-gradient(180deg, #123922, #0c1f16);
    color:#8fe3ac;
    opacity:0.55;
  }
  .key.key-wrong{
    border-color:var(--bad);
    background:linear-gradient(180deg, #3a1210, #220a09);
    color:#ff9a94;
    opacity:0.55;
  }
  .kb-row.diacritics .key{ font-size:0.95rem; min-width:30px; }

  /* ---------- Wheel panel (right) ---------- */
  .wheel-panel{
    display:flex;
    flex-direction:column;
    align-items:center;
  }

  .wheel-wrap{
    position:relative;
    width:min(70vw, 430px);
    aspect-ratio:1/1;
    margin-top:0;
  }

  .rim-lights{ position:absolute; inset:-18px; border-radius:50%; pointer-events:none; }
  .rim-lights span{
    position:absolute; top:50%; left:50%;
    width:10px; height:10px; margin:-5px;
    border-radius:50%;
    background:var(--gold-2);
    box-shadow:0 0 10px 3px rgba(255,221,87,0.85);
    transform-origin:center;
    animation:chase 1.6s linear infinite;
  }
  @keyframes chase{ 0%, 20%{ opacity:1; } 21%, 100%{ opacity:0.18; } }

  .wheel-outer{
    position:absolute; inset:0; border-radius:50%;
    background:conic-gradient(from 0deg, #7a5b0a, var(--gold) 8%, #7a5b0a 16%);
    padding:14px;
    box-shadow:0 0 0 6px #08051a, 0 25px 60px rgba(0,0,0,0.55), var(--ring-shadow);
  }

  .wheel{
    position:relative; width:100%; height:100%; border-radius:50%;
    overflow:hidden; background:var(--navy-2);
    transition: transform 5.2s cubic-bezier(0.12, 0.72, 0.10, 1);
    will-change: transform;
  }
  .wheel svg{ display:block; width:100%; height:100%; }

  .wheel-wrap.spinning .wheel-outer{
    animation: wheelGlowPulse 0.55s ease-in-out infinite;
  }
  @keyframes wheelGlowPulse{
    0%,100%{ box-shadow:0 0 0 6px #08051a, 0 25px 60px rgba(0,0,0,0.55), 0 0 55px rgba(242,183,5,0.35); }
    50%{ box-shadow:0 0 0 6px #08051a, 0 25px 60px rgba(0,0,0,0.55), 0 0 105px rgba(242,183,5,0.8); }
  }
  .wheel-wrap.spinning .rim-lights span{ animation-duration:0.5s; }
  .wheel-wrap.spinning .hub{
    animation: hubPulse 0.5s ease-in-out infinite;
  }
  @keyframes hubPulse{
    0%,100%{ transform:translate(-50%,-50%) scale(1); }
    50%{ transform:translate(-50%,-50%) scale(1.12); }
  }

  .hub{
    position:absolute; top:50%; left:50%;
    width:16%; height:16%;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff2b0, var(--gold) 45%, #a3760a 100%);
    box-shadow:0 0 0 5px #1a1240, 0 6px 14px rgba(0,0,0,0.5), inset 0 0 10px rgba(0,0,0,0.25);
    z-index:5;
  }

  .pointer{
    position:absolute; top:-8px; left:50%;
    width:38px; height:46px;
    transform:translateX(-50%);
    z-index:10;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));
    transition: transform 0.15s ease;
  }
  .pointer.bump{ transform:translateX(-50%) translateY(4px) rotate(-4deg); }

  @keyframes shakeScreen{
    10%,90%{ transform:translateX(-1px); }
    20%,80%{ transform:translateX(2px); }
    30%,50%,70%{ transform:translateX(-5px); }
    40%,60%{ transform:translateX(5px); }
  }
  .shake{ animation:shakeScreen 0.5s; }

  /* ---------- Win overlay (środek ekranu) ---------- */
  .win-overlay{
    position:fixed; inset:0; z-index:300;
    display:flex; align-items:center; justify-content:center;
    opacity:0; visibility:hidden;
    transition:opacity 0.3s ease, visibility 0.3s ease;
    background:radial-gradient(circle at 50% 50%, rgba(12,8,36,0.55), rgba(6,4,20,0.88));
  }
  .win-overlay.show{ opacity:1; visibility:visible; }
  .win-burst{
    position:absolute; top:50%; left:50%;
    width:1100px; height:1100px; max-width:220vw; max-height:220vw;
    background:repeating-conic-gradient(from 0deg, rgba(255,221,87,0.30) 0deg 4deg, transparent 4deg 18deg);
    border-radius:50%;
    animation:rayRotate 20s linear infinite;
    pointer-events:none;
  }
  .win-overlay.negative .win-burst{
    background:repeating-conic-gradient(from 0deg, rgba(224,71,63,0.28) 0deg 4deg, transparent 4deg 18deg);
  }
  @keyframes rayRotate{
    from{ transform:translate(-50%,-50%) rotate(0deg); }
    to{ transform:translate(-50%,-50%) rotate(360deg); }
  }
  .win-content{
    position:relative;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    padding:clamp(24px,5vw,40px) clamp(30px,9vw,70px);
    border-radius:22px;
    border:4px solid var(--gold);
    background:linear-gradient(180deg, #1c1444, #0c0824);
    box-shadow:0 0 0 8px rgba(242,183,5,0.18), 0 30px 70px rgba(0,0,0,0.6), 0 0 90px rgba(242,183,5,0.5);
    animation:winPop 0.6s cubic-bezier(0.22, 1.5, 0.36, 1);
    max-width:90vw;
  }
  .win-overlay.negative .win-content{
    border-color:var(--bad);
    box-shadow:0 0 0 8px rgba(224,71,63,0.18), 0 30px 70px rgba(0,0,0,0.6), 0 0 90px rgba(224,71,63,0.55);
  }
  @keyframes winPop{
    0%{ transform:scale(0.3) rotate(-6deg); opacity:0; }
    50%{ transform:scale(1.14) rotate(2deg); opacity:1; }
    75%{ transform:scale(0.95) rotate(-1deg); }
    100%{ transform:scale(1) rotate(0deg); }
  }
  .win-eyebrow{
    font-size:0.8rem; letter-spacing:0.35em; text-transform:uppercase; color:#c9bff0;
  }
  .win-value{
    font-family:'Bebas Neue', sans-serif;
    font-size:clamp(2.2rem, 8vw, 4.6rem);
    letter-spacing:0.06em;
    text-align:center;
    background:linear-gradient(180deg, #fff7d6 0%, var(--gold) 55%, #b9860a 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:0 2px 0 rgba(0,0,0,0.3);
  }
  .win-overlay.negative .win-value{
    background:linear-gradient(180deg, #ffd8d4 0%, var(--bad) 60%, #7a1712 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .win-hint{
    margin-top:6px;
    font-size:0.68rem;
    letter-spacing:0.15em;
    text-transform:uppercase;
    color:#6f66a0;
  }

  .confetti-piece{
    position:fixed; top:-24px; z-index:250; pointer-events:none; border-radius:2px;
    animation-name:confettiFall; animation-timing-function:cubic-bezier(0.35,0.02,0.65,1); animation-fill-mode:forwards;
  }
  @keyframes confettiFall{
    0%{ transform:translateY(0) rotate(0deg); opacity:1; }
    100%{ transform:translateY(112vh) rotate(600deg); opacity:0; }
  }

  @media (prefers-reduced-motion: reduce){
    .win-burst, .win-content, .confetti-piece, .shake, .wheel-wrap.spinning .wheel-outer, .wheel-wrap.spinning .hub{ animation:none !important; }
  }

  .controls{
    margin-top:30px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:16px;
  }

  .spin-btn{
    font-family:'Bebas Neue', sans-serif;
    font-size:1.4rem;
    letter-spacing:0.14em;
    padding:15px 42px;
    border:none;
    border-radius:999px;
    cursor:pointer;
    color:#3a2400;
    background:linear-gradient(180deg, #ffe98a, var(--gold) 55%, #c98f05);
    box-shadow:0 8px 0 #8a6103, 0 14px 24px rgba(0,0,0,0.4);
    transition:transform 0.08s ease, box-shadow 0.08s ease;
  }
  .spin-btn:hover{ filter:brightness(1.05); }
  .spin-btn:active{ transform:translateY(6px); box-shadow:0 2px 0 #8a6103, 0 6px 12px rgba(0,0,0,0.4); }
  .spin-btn:disabled{ opacity:0.55; cursor:not-allowed; filter:grayscale(0.3); }
  .spin-btn:disabled:active{ transform:none; box-shadow:0 8px 0 #8a6103, 0 14px 24px rgba(0,0,0,0.4); }

  .result{ min-height:66px; display:flex; align-items:center; justify-content:center; }
  .result-card{
    padding:12px 30px;
    border-radius:12px;
    background:linear-gradient(180deg, #1c1444, #0c0824);
    border:2px solid var(--gold);
    font-family:'Bebas Neue', sans-serif;
    font-size:1.4rem;
    letter-spacing:0.08em;
    text-align:center;
    color:var(--gold-2);
    opacity:0;
    transform:scale(0.8) translateY(6px);
    transition:opacity 0.35s ease, transform 0.35s ease;
  }
  .result-card.show{ opacity:1; transform:scale(1) translateY(0); }
  .result-card .label{
    display:block;
    font-family:'Poppins', sans-serif;
    font-size:0.65rem;
    letter-spacing:0.3em;
    text-transform:uppercase;
    color:#c9bff0;
    margin-bottom:2px;
  }

  footer{
    margin-top:44px;
    font-size:0.7rem;
    letter-spacing:0.15em;
    color:#6f66a0;
    text-transform:uppercase;
  }

  /* ---------- Modal ---------- */
  .modal-overlay{
    position:fixed; inset:0;
    background:rgba(4,2,16,0.72);
    backdrop-filter:blur(3px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:100;
    padding:20px;
  }
  .modal-overlay.open{ display:flex; }
  .modal{
    width:100%;
    max-width:480px;
    background:linear-gradient(180deg, #1c1444, #0c0824);
    border:3px solid var(--gold);
    border-radius:16px;
    padding:26px 26px 22px;
    box-shadow:0 20px 50px rgba(0,0,0,0.6), var(--ring-shadow);
  }
  .modal h2{
    font-family:'Bebas Neue', sans-serif;
    letter-spacing:0.08em;
    font-size:1.6rem;
    margin:0 0 6px;
    color:var(--gold-2);
  }
  .modal p{
    font-size:0.8rem;
    color:#c9bff0;
    margin:0 0 14px;
    line-height:1.5;
  }
  .modal textarea{
    width:100%;
    min-height:150px;
    resize:vertical;
    background:rgba(255,246,223,0.06);
    border:2px solid #3a3167;
    border-radius:10px;
    color:var(--paper);
    font-family:'Poppins', sans-serif;
    font-size:0.9rem;
    padding:12px 14px;
    line-height:1.6;
    outline:none;
  }
  .modal textarea:focus{ border-color:var(--gold); }
  .modal-actions{
    display:flex;
    justify-content:flex-end;
    gap:10px;
    margin-top:16px;
  }
  .modal-btn{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:0.82rem;
    padding:10px 20px;
    border-radius:8px;
    cursor:pointer;
    border:2px solid transparent;
  }
  .modal-btn.cancel{
    background:transparent;
    border-color:#3a3167;
    color:#c9bff0;
  }
  .modal-btn.cancel:hover{ border-color:var(--gold); color:var(--gold-2); }
  .modal-btn.save{
    background:linear-gradient(180deg, #ffe98a, var(--gold) 55%, #c98f05);
    color:#3a2400;
  }
  .modal-btn.save:hover{ filter:brightness(1.08); }

  .pkt-modal{ max-width:520px; }
  .pkt-list{
    max-height:50vh;
    overflow-y:auto;
    display:flex;
    flex-direction:column;
    gap:8px;
    padding-right:4px;
  }
  .pkt-row{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .pkt-row .pkt-idx{
    width:20px;
    flex:none;
    font-family:'Bebas Neue', sans-serif;
    font-size:1rem;
    color:#c9bff0;
    text-align:right;
  }
  .pkt-row input[type="text"]{
    flex:1;
    min-width:0;
    background:rgba(255,246,223,0.06);
    border:2px solid #3a3167;
    border-radius:8px;
    color:var(--paper);
    font-family:'Poppins', sans-serif;
    font-size:0.85rem;
    font-weight:600;
    text-transform:uppercase;
    padding:9px 11px;
    outline:none;
  }
  .pkt-row input[type="text"]:focus{ border-color:var(--gold); }
  .pkt-row input[type="color"]{
    flex:none;
    width:36px;
    height:36px;
    padding:0;
    border:2px solid #3a3167;
    border-radius:8px;
    background:none;
    cursor:pointer;
  }

  @media (prefers-reduced-motion: reduce){
    .bulb, .rim-lights span{ animation:none; }
    .wheel{ transition:none; }
    .letter-box.reveal-anim{ animation:none; }
  }
</style>
</head>
<body>

<button class="add-btn" id="openModalBtn">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
  Dodaj hasła
</button>

<button class="add-btn pkt-btn" id="openPktModalBtn">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
  PKT
</button>

<div class="stage">

  <div class="marquee">
    <div class="bulbs" id="bulbs"></div>
    <h1>Koło Fortuny</h1>
  </div>
  <div class="subtitle">Odgadnij hasło i zakręć kołem</div>

  <div class="game-layout">

    <!-- LEFT: puzzle -->
    <div class="puzzle-panel">
      <div class="board" id="board">
        <div class="solved-banner" id="solvedBanner">Rozwiązane!</div>
      </div>

      <div class="puzzle-controls">
        <button class="redraw-btn" id="redrawBtn">Losuj inne hasło</button>
        <div class="select-phrase">
          <select id="phraseSelect" title="Wybierz nr hasła"></select>
          <button class="redraw-btn" id="selectPhraseBtn">Wybierz nr hasła</button>
        </div>
      </div>

      <div class="keyboard" id="keyboard"></div>
    </div>

    <!-- RIGHT: wheel -->
    <div class="wheel-panel">
      <div class="wheel-wrap" id="wheelWrap">
        <div class="rim-lights" id="rimLights"></div>
        <div class="wheel-outer">
          <div class="wheel" id="wheel">
            <svg viewBox="0 0 600 600" id="wheelSvg"></svg>
          </div>
        </div>
        <div class="hub"></div>
        <svg class="pointer" id="pointer" viewBox="0 0 38 46" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 46 L2 12 A19 19 0 1 1 36 12 Z" fill="#f2b705" stroke="#0c0824" stroke-width="2.5"/>
          <circle cx="19" cy="15" r="6" fill="#0c0824"/>
        </svg>
      </div>

      <div class="controls">
        <button class="spin-btn" id="spinBtn">Zakręć kołem</button>
        <div class="result">
          <div class="result-card" id="resultCard">
            <span class="label">Wypadło</span>
            <span id="resultText">—</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <footer>Koło losowe &middot; każdy wynik równie prawdopodobny</footer>
</div>

<!-- Win overlay (wynik na środku ekranu) -->
<div class="win-overlay" id="winOverlay">
  <div class="win-burst"></div>
  <div class="win-content">
    <span class="win-eyebrow">Wypadło</span>
    <span class="win-value" id="winValue">—</span>
    <span class="win-hint">Kliknij, aby zamknąć</span>
  </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <h2>Dodaj hasła</h2>
    <p>Wpisz jedno hasło w każdej linii. Po zapisaniu jedno z nich zostanie wylosowane na planszę.</p>
    <textarea id="phrasesInput" placeholder="np.&#10;KOŁO FORTUNY&#10;ZŁOTA RYBKA&#10;PODRÓŻ DOOKOŁA ŚWIATA"></textarea>
    <div class="modal-actions">
      <button class="modal-btn cancel" id="cancelModalBtn">Anuluj</button>
      <button class="modal-btn save" id="saveModalBtn">Zapisz</button>
    </div>
  </div>
</div>

<!-- Modal PKT -->
<div class="modal-overlay" id="pktModalOverlay">
  <div class="modal pkt-modal">
    <h2>Edytuj pola koła</h2>
    <p>Zmień treść i kolor każdego pola koła fortuny.</p>
    <div class="pkt-list" id="pktList"></div>
    <div class="modal-actions">
      <button class="modal-btn cancel" id="cancelPktModalBtn">Anuluj</button>
      <button class="modal-btn save" id="savePktModalBtn">Zapisz</button>
    </div>
  </div>
</div>

<script>
(function(){
  // =========================================================
  // WHEEL
  // =========================================================
  const segments = [
    { label:"500",    color:"#c81d45" },
    { label:"BANKRUT",color:"#111111" },
    { label:"400",    color:"#0e9c93" },
    { label:"1000",   color:"#6c2ba6" },
    { label:"200",    color:"#e8743e" },
    { label:"150",    color:"#1d8fc8" },
    { label:"AGD",    color:"#c41e7a" },
    { label:"300",    color:"#7cb518" },
    { label:"2000",   color:"#1b2a6b" },
    { label:"100",    color:"#e0a106" },
    { label:"STRATA TURY", color:"#7a2f6b" },
    { label:"350",    color:"#12a594" },
    { label:"800",    color:"#d63872" },
    { label:"250",    color:"#4b3f8a" },
    { label:"WCZASY", color:"#e8543e" },
    { label:"150",    color:"#0e6b6b" }
  ];

  const N = segments.length;
  const seg = 360 / N;
  const cx = 300, cy = 300, r = 292;

  function toXY(angleDeg, radius){
    const rad = (angleDeg * Math.PI) / 180;
    return { x: cx + radius * Math.sin(rad), y: cy - radius * Math.cos(rad) };
  }

  const svg = document.getElementById('wheelSvg');

  function renderWheel(){
    let markup = '';

    segments.forEach((s, i) => {
      const a0 = i * seg;
      const a1 = (i + 1) * seg;
      const mid = a0 + seg / 2;
      const p0 = toXY(a0, r);
      const p1 = toXY(a1, r);

      markup += `<path d="M ${cx},${cy} L ${p0.x.toFixed(2)},${p0.y.toFixed(2)} A ${r},${r} 0 0,1 ${p1.x.toFixed(2)},${p1.y.toFixed(2)} Z"
                  fill="${s.color}" stroke="#0c0824" stroke-width="3"/>`;

      const textRadius = r * 0.62;
      const tp = toXY(mid, textRadius);
      const fontSize = s.label.length > 6 ? 22 : (s.label.length > 3 ? 27 : 34);
      const textRotate = mid + 90;

      markup += `<text x="${tp.x.toFixed(2)}" y="${tp.y.toFixed(2)}"
                  text-anchor="middle" dominant-baseline="middle"
                  transform="rotate(${textRotate.toFixed(2)} ${tp.x.toFixed(2)} ${tp.y.toFixed(2)})"
                  font-family="'Bebas Neue', sans-serif" font-size="${fontSize}"
                  fill="#fff6df" style="paint-order: stroke; stroke:#0c0824; stroke-width:3px; letter-spacing:1px;">${s.label}</text>`;
    });

    svg.innerHTML = markup;
  }

  renderWheel();

  // ---------- Marquee bulbs ----------
  const bulbsBox = document.getElementById('bulbs');
  const bulbCount = 26;
  for(let i=0;i<bulbCount;i++){
    const b = document.createElement('div');
    b.className = 'bulb';
    const t = i / bulbCount;
    let x;
    if(t < 0.5){ x = t/0.5*100; b.style.top='4px'; b.style.left = x+'%'; }
    else { x = (t-0.5)/0.5*100; b.style.bottom='4px'; b.style.left = x+'%'; }
    b.style.animationDelay = (i * 0.06) + 's';
    bulbsBox.appendChild(b);
  }

  // ---------- Rim chase lights ----------
  const rim = document.getElementById('rimLights');
  const rimCount = 32;
  for(let i=0;i<rimCount;i++){
    const dot = document.createElement('span');
    const angle = (360/rimCount) * i;
    const rad = angle * Math.PI/180;
    dot.style.left = (50 + 49*Math.sin(rad)) + '%';
    dot.style.top = (50 - 49*Math.cos(rad)) + '%';
    dot.style.animationDelay = (i * (1.6/rimCount)) + 's';
    rim.appendChild(dot);
  }

  // ---------- Dźwięki (Web Audio API, bez plików zewnętrznych) ----------
  let audioCtx;
  function getAudioCtx(){
    if(!audioCtx){
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if(!Ctx) return null;
      audioCtx = new Ctx();
    }
    if(audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function playTick(strength){
    const ctx = getAudioCtx();
    if(!ctx) return;
    const t = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(1250 + Math.random() * 260, t);
    const vol = 0.10 + 0.12 * (strength || 0);
    gain.gain.setValueAtTime(vol, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.055);
    osc.connect(gain).connect(ctx.destination);
    osc.start(t);
    osc.stop(t + 0.06);
  }

  function playWhoosh(){
    const ctx = getAudioCtx();
    if(!ctx) return;
    const t = ctx.currentTime;
    const dur = 0.55;
    const bufferSize = Math.floor(ctx.sampleRate * dur);
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for(let i = 0; i < bufferSize; i++){
      data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
    }
    const noise = ctx.createBufferSource();
    noise.buffer = buffer;
    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(500, t);
    filter.frequency.exponentialRampToValueAtTime(2600, t + dur);
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(0.28, t);
    gain.gain.linearRampToValueAtTime(0.0001, t + dur);
    noise.connect(filter).connect(gain).connect(ctx.destination);
    noise.start(t);
    noise.stop(t + dur);
  }

  function playFanfare(){
    const ctx = getAudioCtx();
    if(!ctx) return;
    const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
    notes.forEach((freq, i) => {
      const t = ctx.currentTime + i * 0.11;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, t);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(0.22, t + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      osc.connect(gain).connect(ctx.destination);
      osc.start(t);
      osc.stop(t + 0.42);
    });
  }

  function playSad(){
    const ctx = getAudioCtx();
    if(!ctx) return;
    const notes = [392.00, 349.23, 311.13, 261.63];
    notes.forEach((freq, i) => {
      const t = ctx.currentTime + i * 0.17;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(freq, t);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(0.16, t + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.32);
      osc.connect(gain).connect(ctx.destination);
      osc.start(t);
      osc.stop(t + 0.36);
    });
  }

  // ---------- Konfetti ----------
  const CONFETTI_COLORS = ['#f2b705', '#ffdd57', '#e0473f', '#3fbf6a', '#1d8fc8', '#c41e7a', '#fff6df'];
  function spawnConfetti(count){
    for(let i = 0; i < count; i++){
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      const size = 6 + Math.random() * 7;
      const isCircle = Math.random() > 0.5;
      piece.style.width = size + 'px';
      piece.style.height = (isCircle ? size : size * 1.7) + 'px';
      piece.style.borderRadius = isCircle ? '50%' : '2px';
      piece.style.background = CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];
      piece.style.left = Math.random() * 100 + 'vw';
      const duration = 2.4 + Math.random() * 1.8;
      const delay = Math.random() * 0.5;
      piece.style.animationDuration = duration + 's';
      piece.style.animationDelay = delay + 's';
      document.body.appendChild(piece);
      setTimeout(() => piece.remove(), (duration + delay) * 1000 + 200);
    }
  }

  // ---------- Overlay wyniku (środek ekranu) ----------
  const NEGATIVE_LABELS = new Set(['BANKRUT', 'STRATA TURY']);
  const winOverlay = document.getElementById('winOverlay');
  const winValue = document.getElementById('winValue');
  let winHideTimer = null;

  function showWinOverlay(label){
    const negative = NEGATIVE_LABELS.has(label);
    winValue.textContent = label;
    winOverlay.classList.toggle('negative', negative);
    winOverlay.classList.add('show');

    if(negative){
      playSad();
      document.body.classList.remove('shake');
      void document.body.offsetWidth;
      document.body.classList.add('shake');
      setTimeout(() => document.body.classList.remove('shake'), 550);
    } else {
      playFanfare();
      spawnConfetti(70);
    }

    clearTimeout(winHideTimer);
    winHideTimer = setTimeout(hideWinOverlay, 2800);
  }

  function hideWinOverlay(){
    winOverlay.classList.remove('show');
    clearTimeout(winHideTimer);
  }

  winOverlay.addEventListener('click', hideWinOverlay);

  // ---------- Spin logic ----------
  const wheel = document.getElementById('wheel');
  const wheelWrap = document.getElementById('wheelWrap');
  const btn = document.getElementById('spinBtn');
  const pointer = document.getElementById('pointer');
  const resultCard = document.getElementById('resultCard');
  const resultText = document.getElementById('resultText');

  let currentRotation = 0;
  let spinning = false;

  function segmentIndexAtPointer(rotationDeg){
    const mod = ((rotationDeg % 360) + 360) % 360;
    const normalized = ((360 - mod) % 360 + 360) % 360;
    return Math.floor(normalized / seg);
  }

  function tickLoop(lastSeg){
    if(!spinning) return;

    const style = getComputedStyle(wheel).transform;
    let angle = null;
    if(style && style !== 'none'){
      const match = style.match(/matrix\(([^)]+)\)/);
      if(match){
        const parts = match[1].split(',').map(Number);
        const a = parts[0], b = parts[1];
        angle = (Math.atan2(b, a) * 180 / Math.PI + 360) % 360;
      }
    }

    if(angle !== null){
      const segIndex = segmentIndexAtPointer(angle);
      if(segIndex !== lastSeg){
        lastSeg = segIndex;
        playTick();
        pointer.classList.add('bump');
        setTimeout(() => pointer.classList.remove('bump'), 90);
      }
    }

    requestAnimationFrame(() => tickLoop(lastSeg));
  }

  btn.addEventListener('click', () => {
    if(spinning) return;
    spinning = true;
    btn.disabled = true;
    resultCard.classList.remove('show');
    hideWinOverlay();

    playWhoosh();
    wheelWrap.classList.add('spinning');

    const winnerIndex = Math.floor(Math.random() * N);
    const midAngle = winnerIndex * seg + seg / 2;

    const maxJitter = seg * 0.32;
    const jitter = (Math.random() * 2 - 1) * maxJitter;

    const targetMod = ((360 - (midAngle + jitter)) % 360 + 360) % 360;
    const currentMod = ((currentRotation % 360) + 360) % 360;
    let delta = targetMod - currentMod;
    if (delta < 0) delta += 360;

    const extraSpins = 6 + Math.floor(Math.random() * 3);
    currentRotation += delta + extraSpins * 360;

    const startSeg = segmentIndexAtPointer(currentRotation - (delta + extraSpins * 360));
    wheel.style.transform = `rotate(${currentRotation}deg)`;
    requestAnimationFrame(() => tickLoop(startSeg));

    setTimeout(() => {
      pointer.classList.add('bump');
      setTimeout(() => pointer.classList.remove('bump'), 220);

      resultText.textContent = segments[winnerIndex].label;
      resultCard.classList.add('show');

      wheelWrap.classList.remove('spinning');
      spinning = false;
      btn.disabled = false;

      showWinOverlay(segments[winnerIndex].label);
    }, 5300);
  });

  // =========================================================
  // PUZZLE (HASŁO)
  // =========================================================
  const LETTER_RE = /[A-ZĄĆĘŁŃÓŚŹŻ]/;

  let phrases = ["KOŁO FORTUNY", "ZŁOTA RYBKA", "PODRÓŻ DOOKOŁA ŚWIATA"];
  let currentPhrase = "";
  let revealed = new Set();
  let usedKeys = new Set();

  const board = document.getElementById('board');
  const solvedBanner = document.getElementById('solvedBanner');
  const keyboard = document.getElementById('keyboard');
  const redrawBtn = document.getElementById('redrawBtn');
  const phraseSelect = document.getElementById('phraseSelect');
  const selectPhraseBtn = document.getElementById('selectPhraseBtn');

  const VOWEL_ROWS = [
    ["A","Ą","E"],
    ["Ę","I","O"],
    ["Ó","U","Y"]
  ];
  const CONSONANT_ROWS = [
    ["B","C","Ć","D","F","G","H"],
    ["J","K","L","Ł","M","N","Ń"],
    ["P","Q","R","S","Ś","T","V"],
    ["W","X","Z","Ź","Ż"]
  ];

  function buildKeyboardGroup(label, rows){
    const group = document.createElement('div');
    group.className = 'kb-group';

    const labelEl = document.createElement('div');
    labelEl.className = 'kb-group-label';
    labelEl.textContent = label;
    group.appendChild(labelEl);

    rows.forEach(row => {
      const rowEl = document.createElement('div');
      rowEl.className = 'kb-row';
      row.forEach(letter => {
        const keyEl = document.createElement('button');
        keyEl.className = 'key';
        keyEl.textContent = letter;
        keyEl.dataset.letter = letter;
        keyEl.addEventListener('click', () => handleGuess(letter, keyEl));
        rowEl.appendChild(keyEl);
      });
      group.appendChild(rowEl);
    });

    return group;
  }

  function buildKeyboard(){
    keyboard.innerHTML = '';
    keyboard.appendChild(buildKeyboardGroup('Samogłoski', VOWEL_ROWS));
    keyboard.appendChild(buildKeyboardGroup('Spółgłoski', CONSONANT_ROWS));
  }

  function normalize(str){
    return str.toLocaleUpperCase('pl-PL');
  }

  function pickRandomPhrase(){
    const idx = Math.floor(Math.random() * phrases.length);
    return normalize(phrases[idx]);
  }

  function populatePhraseSelect(){
    phraseSelect.innerHTML = '';
    phrases.forEach((p, i) => {
      const opt = document.createElement('option');
      opt.value = i;
      opt.textContent = `Hasło ${i + 1}`;
      phraseSelect.appendChild(opt);
    });
  }

  function startRoundWithPhrase(phraseText){
    currentPhrase = normalize(phraseText);
    revealed = new Set();
    usedKeys = new Set();
    resetKeyboardState();
    renderBoard();
  }

  function renderBoard(animateLetters){
    board.querySelectorAll('.word-group').forEach(el => el.remove());
    const words = currentPhrase.split(' ');
    words.forEach(word => {
      const wg = document.createElement('div');
      wg.className = 'word-group';
      [...word].forEach(ch => {
        const box = document.createElement('div');
        if (LETTER_RE.test(ch)) {
          const isRevealed = revealed.has(ch);
          box.className = 'letter-box' + (isRevealed ? '' : ' blank');
          box.textContent = isRevealed ? ch : '_';
          if (isRevealed && animateLetters && animateLetters.has(ch)) {
            box.classList.add('reveal-anim');
          }
        } else {
          box.className = 'letter-box static';
          box.textContent = ch;
        }
        wg.appendChild(box);
      });
      board.appendChild(wg);
    });
    checkSolved();
  }

  function checkSolved(){
    const letters = [...currentPhrase].filter(ch => LETTER_RE.test(ch));
    const solved = letters.every(ch => revealed.has(ch));
    board.classList.toggle('solved', solved);
    solvedBanner.classList.toggle('show', solved);
  }

  function handleGuess(letter, keyEl){
    if (usedKeys.has(letter)) return;
    usedKeys.add(letter);
    keyEl.disabled = true;

    if (currentPhrase.includes(letter)) {
      revealed.add(letter);
      keyEl.classList.add('key-correct');
      renderBoard(new Set([letter]));
    } else {
      keyEl.classList.add('key-wrong');
    }
  }

  function resetKeyboardState(){
    keyboard.querySelectorAll('.key').forEach(k => {
      k.disabled = false;
      k.classList.remove('key-correct', 'key-wrong');
    });
  }

  function startNewRound(){
    currentPhrase = pickRandomPhrase();
    revealed = new Set();
    usedKeys = new Set();
    resetKeyboardState();
    renderBoard();
  }

  redrawBtn.addEventListener('click', startNewRound);
  selectPhraseBtn.addEventListener('click', () => {
    const idx = parseInt(phraseSelect.value, 10);
    if (!Number.isNaN(idx) && phrases[idx] !== undefined) {
      startRoundWithPhrase(phrases[idx]);
    }
  });

  buildKeyboard();
  populatePhraseSelect();
  startNewRound();

  // =========================================================
  // MODAL — Dodaj hasła
  // =========================================================
  const openModalBtn = document.getElementById('openModalBtn');
  const cancelModalBtn = document.getElementById('cancelModalBtn');
  const saveModalBtn = document.getElementById('saveModalBtn');
  const modalOverlay = document.getElementById('modalOverlay');
  const phrasesInput = document.getElementById('phrasesInput');

  function openModal(){
    phrasesInput.value = phrases.join('\n');
    modalOverlay.classList.add('open');
    setTimeout(() => phrasesInput.focus(), 50);
  }
  function closeModal(){
    modalOverlay.classList.remove('open');
  }

  openModalBtn.addEventListener('click', openModal);
  cancelModalBtn.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOverlay.classList.contains('open')) closeModal();
  });

  saveModalBtn.addEventListener('click', () => {
    const lines = phrasesInput.value
      .split('\n')
      .map(l => l.trim())
      .filter(l => l.length > 0);

    if (lines.length === 0) {
      phrasesInput.focus();
      return;
    }

    phrases = lines;
    populatePhraseSelect();
    closeModal();
    startNewRound();
  });

  // =========================================================
  // MODAL — PKT (edycja pól koła)
  // =========================================================
  const openPktModalBtn = document.getElementById('openPktModalBtn');
  const cancelPktModalBtn = document.getElementById('cancelPktModalBtn');
  const savePktModalBtn = document.getElementById('savePktModalBtn');
  const pktModalOverlay = document.getElementById('pktModalOverlay');
  const pktList = document.getElementById('pktList');

  function openPktModal(){
    pktList.innerHTML = '';
    segments.forEach((s, i) => {
      const row = document.createElement('div');
      row.className = 'pkt-row';

      const idx = document.createElement('span');
      idx.className = 'pkt-idx';
      idx.textContent = (i + 1) + '.';

      const textInput = document.createElement('input');
      textInput.type = 'text';
      textInput.value = s.label;
      textInput.dataset.field = 'label';
      textInput.maxLength = 14;

      const colorInput = document.createElement('input');
      colorInput.type = 'color';
      colorInput.value = s.color;
      colorInput.dataset.field = 'color';

      row.appendChild(idx);
      row.appendChild(textInput);
      row.appendChild(colorInput);
      pktList.appendChild(row);
    });

    pktModalOverlay.classList.add('open');
  }
  function closePktModal(){
    pktModalOverlay.classList.remove('open');
  }

  openPktModalBtn.addEventListener('click', openPktModal);
  cancelPktModalBtn.addEventListener('click', closePktModal);
  pktModalOverlay.addEventListener('click', (e) => {
    if (e.target === pktModalOverlay) closePktModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && pktModalOverlay.classList.contains('open')) closePktModal();
  });

  savePktModalBtn.addEventListener('click', () => {
    const rows = pktList.querySelectorAll('.pkt-row');
    rows.forEach((row, i) => {
      const textInput = row.querySelector('input[type="text"]');
      const colorInput = row.querySelector('input[type="color"]');
      const newLabel = textInput.value.trim().toLocaleUpperCase('pl-PL');
      if (newLabel.length > 0) {
        segments[i].label = newLabel;
      }
      segments[i].color = colorInput.value;
    });

    renderWheel();
    closePktModal();
  });

})();
</script>

</body>
</html>
